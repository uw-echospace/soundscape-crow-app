{
  "name": "stf-am-gui",
  "productName": "CROW",
  "version": "1.0.1",
  "description": "Community Recording Online Workflow app for Seattle Soundscape",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:analyzer": "pyinstaller --noconfirm --onedir --copy-metadata soxr --copy-metadata ai-edge-litert --name analyzer --distpath build/analyzer --workpath build/pyinstaller --specpath build analyze.py",
    "dist": "electron-builder"
  },
  "dependencies": {
    "audiomoth-hid": "2.3.0",
    "electron-updater": "6.8.11",
    "exifr": "7.1.3",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.stf.audiomoth",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "index.html",
      "help.txt",
      "guide.txt",
      "assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/audiomoth-hid/bin/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "uw-echospace",
      "repo": "soundscape-crow-app",
      "releaseType": "draft"
    },
    "npmRebuild": false,
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "bin/macos",
          "to": "bin"
        },
        {
          "from": "build/analyzer/analyzer",
          "to": "analyzer"
        },
        {
          "from": "models",
          "to": "models"
        },
        {
          "from": "addon",
          "to": "addon",
          "filter": [
            "zoo_runner.py",
            "models.json",
            "base.txt",
            "full.txt"
          ]
        }
      ],
      "x64ArchFiles": "Contents/Resources/analyzer/**",
      "icon": "assets/AppIcon.icon",
      "artifactName": "CROW-${version}-universal.${ext}"
    },
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "bin/windows",
          "to": "bin"
        },
        {
          "from": "build/analyzer/analyzer",
          "to": "analyzer"
        },
        {
          "from": "models",
          "to": "models"
        },
        {
          "from": "addon",
          "to": "addon",
          "filter": [
            "zoo_runner.py",
            "models.json",
            "base.txt",
            "full.txt"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "extraResources": [
        {
          "from": "bin/linux",
          "to": "bin"
        },
        {
          "from": "build/analyzer/analyzer",
          "to": "analyzer"
        },
        {
          "from": "models",
          "to": "models"
        },
        {
          "from": "addon",
          "to": "addon",
          "filter": [
            "zoo_runner.py",
            "models.json",
            "base.txt",
            "full.txt"
          ]
        }
      ],
      "artifactName": "CROW-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "CROW-Setup-${version}.${ext}"
    }
  }
}
